# Connexion PostgreSQL. Voir README.md pour Docker vs base hébergée (Neon/Supabase/Railway).
DATABASE_URL="postgresql://jouetbois:jouetbois@localhost:5432/jouetbois?schema=public"

# Secret utilisé pour signer les JWT (chaîne aléatoire longue en production)
JWT_SECRET="change-me-dev-secret"

# Origine du frontend autorisée en CORS
CLIENT_URL="http://localhost:5173"

# Port du serveur Express
PORT=4000

# Clés Stripe en mode test (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"
