generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(CUSTOMER)
  orders       Order[]
  favorites    Favorite[]
  reviews      Review[]
  createdAt    DateTime @default(now())
}

model Category {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String
  tagline  String
  imageUrl String?
  products Product[]
}

model Product {
  id              String      @id @default(cuid())
  slug            String      @unique
  name            String
  description     String
  priceCents      Int
  currency        String      @default("eur")
  illustrationKey String
  accentColor     String      @default("sage")
  imageUrl        String?
  // Photos supplémentaires affichées dans la galerie de la fiche produit
  images          String[]    @default([])
  material        String?
  ageRange        String?
  stock           Int         @default(20)
  featured        Boolean     @default(false)
  isNew           Boolean     @default(false)
  // Un produit masqué n'apparaît plus dans la boutique mais reste lié aux commandes passées
  active          Boolean     @default(true)
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  orderItems      OrderItem[]
  favorites       Favorite[]
  reviews         Review[]
  createdAt       DateTime    @default(now())
}

model Order {
  id                 String      @id @default(cuid())
  userId             String?
  user               User?       @relation(fields: [userId], references: [id])
  email              String
  status             OrderStatus @default(PENDING)
  totalCents         Int
  promoCode          String?
  discountCents      Int         @default(0)
  currency           String      @default("eur")
  stripeSessionId    String?     @unique
  shippingName       String
  shippingAddress    String
  shippingCity       String
  shippingPostalCode String
  shippingCountry    String
  items              OrderItem[]
  createdAt          DateTime    @default(now())
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
}

model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String
  // Un avis n'est visible publiquement qu'après validation dans l'admin
  approved  Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
