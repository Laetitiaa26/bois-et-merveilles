{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://bois-et-merveilles-api.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://bois-et-merveilles-api.onrender.com/uploads/:path*" },
    { "source": "/((?!.*\.).*)", "destination": "/index.html" }
  ]
}
